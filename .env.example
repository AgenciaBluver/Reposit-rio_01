# ─────────────────────────────────────────────────────────────
# BLUVER — variáveis de ambiente
# Nenhum ID fictício é versionado. Preencha no deploy.
# ─────────────────────────────────────────────────────────────

# URL canônica (sem barra final). Usada por canonical, OG e sitemap.
NEXT_PUBLIC_SITE_URL=https://www.agenciabluver.com.br

# Analytics — deixe VAZIO para não carregar nada.
# O site funciona integralmente sem qualquer script de terceiro.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Contato
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=contato@agenciabluver.com.br
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/agenciabluver
NEXT_PUBLIC_LINKEDIN=

# Endpoint do formulário (server action encaminha para cá).
FORM_ENDPOINT=
